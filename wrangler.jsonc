{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cotizaciones",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
